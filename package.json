{
  "name": "d-r-a-rpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @rpg/game-web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "depcruise": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "validate:data": "tsx tools/data-validator/validate.ts",
    "assets:build": "tsx tools/asset-processor/build.ts",
    "smoke": "tsx tools/smoke/smoke.ts",
    "dev:mobile": "pnpm --filter @rpg/game-web dev:mobile",
    "maps:build": "tsx tools/map-builder/build.ts",
    "nav:build": "tsx tools/navmesh-builder/build.ts",
    "content:build": "pnpm maps:build && pnpm nav:build && pnpm validate:data",
    "pwa:icons": "tsx tools/asset-processor/icons.ts",
    "preview": "pnpm --filter @rpg/game-web preview",
    "dev:game-server": "pnpm --filter @rpg/game-server dev",
    "dev:api": "pnpm --filter @rpg/api-server dev",
    "dev:admin": "pnpm --filter @rpg/admin dev",
    "db:generate": "pnpm --filter @rpg/persistence db:generate",
    "dev:stack": "tsx --env-file-if-exists=.env tools/dev-stack/main.ts",
    "smoke:login": "tsx tools/smoke/login-flow.ts",
    "assets:convert": "tsx tools/asset-processor/convert.ts",
    "assets:inspect": "tsx tools/asset-processor/inspect.ts",
    "assets:sheet": "tsx tools/asset-processor/contact-sheet.ts",
    "media:build": "tsx tools/asset-processor/media.ts",
    "smoke:gear": "tsx tools/smoke/gear-fit.ts",
    "assets:proportions": "tsx tools/asset-processor/proportions.ts",
    "assets:vendor": "tsx tools/asset-processor/vendor.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
