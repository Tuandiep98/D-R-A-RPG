# Copy to .env. Never commit real secrets (tech plan §55.1 item 9).
# Shared HS256 secret for access tokens and portal tickets (>= 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-change-me-change-me-change-me

# Docker stack (infra/docker/docker-compose.yml)
POSTGRES_PASSWORD=change-me
DOMAIN=localhost

# Local dev without Docker: leave DATABASE_URL empty to use PGlite in .data/pglite
# DATABASE_URL=postgres://rpg:change-me@localhost:5432/rpg
# REDIS_URL=redis://localhost:6379

# Game server dev conveniences (must be false in production)
ALLOW_DEV_LOGIN=true

# Web client (Vite exposes only VITE_* variables — never put secrets here)
VITE_API_URL=http://localhost:3000
